# AgentBrain Environment Variables
# Copy this file to .env and fill in the values

# Python executable path (default: python)
AGENTBRAIN_PYTHON_PATH=python

# Path to agentbrain-core directory
AGENTBRAIN_CORE_PATH=

# Ollama server URL
AGENTBRAIN_OLLAMA_URL=http://localhost:11434

# Memory server URL (optional)
AGENTBRAIN_MEMORY_URL=http://localhost:8000

# Enable debug logging (true/false)
AGENTBRAIN_DEBUG=false
